# Copy to .env (git-ignored). Vite only exposes vars prefixed with VITE_.

# Base URL the UI shows/uses for capture endpoints. Defaults to
# http://<current-host>:3001 when unset. Set this to your public URL when
# tunnelling (e.g. ngrok) so the displayed endpoint is correct:
#   VITE_INGEST_BASE=https://abc123.ngrok-free.app
VITE_INGEST_BASE=
