# Copy to .env (git-ignored) and adjust as needed.

PORT=3001

# Comma-separated origins allowed to call the API from a browser.
# Add your ngrok frontend URL here when testing remotely.
CORS_ORIGINS=http://localhost:5173

# Max captured request body size.
MAX_BODY_SIZE=1mb

# How many requests to keep per bin (oldest dropped past this).
MAX_REQUESTS_PER_BIN=100

# --- databases (match docker-compose.yml) ---
DATABASE_URL=postgres://requestbin:requestbin@localhost:5433/requestbin
MONGO_URL=mongodb://localhost:27017
MONGO_DB=requestbin
