PORT=3000

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=requestbin

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=requestbin

# Set to "production" to enable the `secure` flag on the session cookie
NODE_ENV=development

# Your frontend's dev server URL, once it exists — needed for CORS to
# allow the session cookie on cross-origin requests
ALLOWED_ORIGIN=http://localhost:5173

# Optional overrides for previously-hardcoded settings (all have sensible
# defaults if omitted — see src/config/env.js)
# SESSION_COOKIE_NAME=session_id
# SESSION_MAX_AGE_DAYS=30
# CLEANUP_EXPIRATION_DAYS=7
# CLEANUP_INTERVAL_HOURS=1
# CAPTURE_BODY_LIMIT=5mb
